# Application Settings
APP_NAME="One-Click Attendance System"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
SECRET_KEY=super-secret-key-for-one-click-attendance-2026

# Database
DATABASE_URL=sqlite:///./attendance.db

# CORS (Comma-separated origins or * for dev)
CORS_ORIGINS=*

# Storage Paths (relative to backend or absolute)
FACES_DIR=../data/faces
ATTENDANCE_PHOTOS_DIR=../data/attendance_photos
CV_MODELS_DIR=../data/models

# Computer Vision Recognition Settings
# Cosine distance or L2 distance threshold for face match
FACE_MATCH_THRESHOLD=0.60
MIN_FACE_CONFIDENCE=0.70
